{
  "name": "@virgilvox/beam-link",
  "version": "0.0.0",
  "description": "BEAM SDK: transports, device orchestration, credit-window streaming, and the safety contract. Drive a BEAM machine from your own page or script.",
  "license": "MIT",
  "author": "Moheeb Zara",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/virgilvox/hackbuild-beam.git",
    "directory": "packages/beam-link"
  },
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
