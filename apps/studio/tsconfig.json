{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "noEmit": true,
    "composite": false,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@theme/*": ["../../theme/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "../../theme/**/*.ts", "../../theme/**/*.vue"]
}
