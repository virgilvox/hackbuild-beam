{
  "name": "hackbuild-beam",
  "version": "0.0.0",
  "private": true,
  "description": "BEAM: laser scanner control. Wire protocol, motion planner, browser SDK, and one control app that drives more than one kind of rig.",
  "license": "MIT",
  "author": "Moheeb Zara",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/virgilvox/hackbuild-beam.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm --filter \"./apps/*\" build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b --pretty && tsc -p packages/beam-core/tsconfig.typecheck.json && tsc -p packages/beam-sources/tsconfig.typecheck.json && tsc -p packages/beam-link/tsconfig.typecheck.json",
    "check": "pnpm lint && pnpm check:style && pnpm check:sketches && pnpm typecheck && pnpm check:invariants && pnpm test",
    "check:invariants": "node tools/check-invariants.mjs",
    "dev": "node tools/dev-server.mjs",
    "check:style": "node tools/check-house-style.mjs",
    "check:sketches": "node tools/check-sketches.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^10.10.0",
    "pinia": "^3.0.4",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.0",
    "vue": "3.5.40",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.12"
  }
}
